<Window x:Class="org_technika.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Сервисный центр" Height="720" Width="1180" MinHeight="600" MinWidth="900" WindowStartupLocation="CenterScreen">
  <Grid Margin="12">
    <Grid x:Name="LoadingPanel" Panel.ZIndex="10" Background="White" Visibility="Visible">
      <StackPanel Width="360" HorizontalAlignment="Center" VerticalAlignment="Center">
        <TextBlock Text="Сервисный центр" FontSize="26" FontWeight="Bold" HorizontalAlignment="Center"/>
        <TextBlock Text="Загрузка системы…" FontSize="15" Margin="0,18,0,10" HorizontalAlignment="Center"/>
        <ProgressBar IsIndeterminate="True" Height="8"/>
      </StackPanel>
    </Grid>
    <StackPanel x:Name="LoginPanel" Width="360" HorizontalAlignment="Center" VerticalAlignment="Center">
      <TextBlock Text="Сервисный центр" FontSize="24" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,20"/>
      <TextBlock Text="Вход в систему" FontSize="16" HorizontalAlignment="Center" Margin="0,0,0,16"/>
      <Label Content="Логин"/><TextBox x:Name="LoginTextBox" Height="28"/>
      <Label Content="Пароль"/><PasswordBox x:Name="PasswordBox" Height="28"/>
      <Button x:Name="LoginButton" Content="Войти" Height="32" Margin="0,18,0,0" Click="LoginButton_Click"/>
      <TextBlock x:Name="LoginStatusText" TextWrapping="Wrap" Foreground="DarkRed" Margin="0,12,0,0"/>
    </StackPanel>
    <DockPanel x:Name="ApplicationPanel" Visibility="Collapsed">
      <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,10">
        <TextBlock Text="Сервисный центр" FontSize="22" FontWeight="Bold"/><TextBlock x:Name="CurrentUserText" Margin="24,4,0,0"/>
        <Button Content="Выйти" Width="90" Margin="24,0,0,0" Click="LogoutButton_Click"/>
      </StackPanel>
      <TabControl x:Name="MainTabs" SelectionChanged="MainTabs_SelectionChanged">
         <TabItem Header="Заказы"><Grid Margin="6"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
          <WrapPanel Margin="0,0,0,8"><Label Content="Поиск"/><TextBox x:Name="OrderSearchTextBox" Width="180" Margin="4,0,12,0" TextChanged="OrderSearchTextBox_TextChanged"/><Label Content="С даты"/><DatePicker x:Name="OrderFromDatePicker" Width="125" Margin="4,0,8,0"/><Label Content="По дату"/><DatePicker x:Name="OrderToDatePicker" Width="125" Margin="4,0,8,0"/><Button Content="Обновить" Width="95" Click="RefreshOrdersButton_Click"/><Button x:Name="CreateOrderButton" Content="Новый заказ" Margin="8,0,0,0" Click="CreateOrderButton_Click"/></WrapPanel>
           <DataGrid x:Name="OrdersGrid" Grid.Row="1" AutoGenerateColumns="False" IsReadOnly="True" SelectionChanged="OrdersGrid_SelectionChanged"><DataGrid.Columns><DataGridTextColumn Header="№" Binding="{Binding OrderNumber}" Width="100"/><DataGridTextColumn Header="Клиент" Binding="{Binding ClientName}" Width="180"/><DataGridTextColumn Header="Оборудование" Binding="{Binding EquipmentType}" Width="140"/><DataGridTextColumn Header="Мастер" Binding="{Binding MasterName}" Width="150"/><DataGridTextColumn Header="Статус" Binding="{Binding StatusName}" Width="170"/><DataGridTextColumn Header="Создан" Binding="{Binding CreatedAt}" Width="140"/><DataGridCheckBoxColumn Header="Оплачен" Binding="{Binding IsPaid}" Width="70"/></DataGrid.Columns></DataGrid>
         </Grid></TabItem>
         <TabItem x:Name="ArchiveTab" Header="Архив"><Grid Margin="6"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><Button Content="Обновить архив" Width="130" HorizontalAlignment="Left" Click="RefreshArchiveButton_Click"/><DataGrid x:Name="ArchiveGrid" Grid.Row="1" AutoGenerateColumns="False" IsReadOnly="True" Margin="0,8,0,0"><DataGrid.Columns><DataGridTextColumn Header="№" Binding="{Binding OrderNumber}" Width="120"/><DataGridTextColumn Header="Клиент" Binding="{Binding ClientName}" Width="180"/><DataGridTextColumn Header="Оборудование" Binding="{Binding EquipmentType}" Width="150"/><DataGridTextColumn Header="Мастер" Binding="{Binding MasterName}" Width="170"/><DataGridTextColumn Header="Статус" Binding="{Binding StatusName}" Width="170"/><DataGridTextColumn Header="Дата создания" Binding="{Binding CreatedAt}" Width="150"/></DataGrid.Columns></DataGrid></Grid></TabItem>
        <TabItem x:Name="OrderDetailsTab" Header="Карточка заказа" IsEnabled="False"><ScrollViewer><StackPanel Margin="12"><TextBlock x:Name="OrderTitleText" FontSize="20" FontWeight="Bold"/><WrapPanel Margin="0,10,0,0"><TextBlock x:Name="OrderClientText" Width="360"/><TextBlock x:Name="OrderEquipmentText" Width="360"/></WrapPanel><TextBlock x:Name="OrderStatusText" Margin="0,8,0,0"/><TextBlock Text="Неисправность" FontWeight="Bold" Margin="0,14,0,2"/><TextBlock x:Name="OrderFaultText" TextWrapping="Wrap"/><TextBlock Text="Диагноз" FontWeight="Bold" Margin="0,14,0,2"/><TextBox x:Name="DiagnosisTextBox" AcceptsReturn="True" Height="70" TextWrapping="Wrap"/><WrapPanel Margin="0,6,0,12"><Button x:Name="SaveDiagnosisButton" Content="Сохранить диагноз" Click="SaveDiagnosisButton_Click"/><Button x:Name="ChangeStatusButton" Content="Изменить статус" Margin="8,0,0,0" Click="ChangeStatusButton_Click"/><Button x:Name="PayOrderButton" Content="Отметить оплату" Margin="8,0,0,0" Click="PayOrderButton_Click"/><Button x:Name="ArchiveOrderButton" Content="Архивировать" Margin="8,0,0,0" Click="ArchiveOrderButton_Click"/></WrapPanel><TextBlock Text="Работы" FontWeight="Bold" FontSize="16"/><DataGrid x:Name="WorksGrid" AutoGenerateColumns="True" IsReadOnly="True" Height="120"/><TextBlock Text="Запчасти" FontWeight="Bold" FontSize="16" Margin="0,10,0,0"/><DataGrid x:Name="PartsGrid" AutoGenerateColumns="True" IsReadOnly="True" Height="120"/><TextBlock x:Name="OrderTotalText" FontWeight="Bold" HorizontalAlignment="Right"/></StackPanel></ScrollViewer></TabItem>
         <TabItem x:Name="ClientsTab" Header="Клиенты"><Grid Margin="6"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><WrapPanel><TextBox x:Name="ClientSearchTextBox" Width="220"/><Button Content="Найти" Margin="8,0,0,0" Click="RefreshClientsButton_Click"/><Button Content="Добавить" Margin="8,0,0,0" Click="AddClientButton_Click"/><Button Content="Изменить" Margin="8,0,0,0" Click="EditClientButton_Click"/><Button Content="Удалить" Margin="8,0,0,0" Click="DeleteClientButton_Click"/></WrapPanel><DataGrid x:Name="ClientsGrid" Grid.Row="1" AutoGenerateColumns="True" IsReadOnly="True" Margin="0,8,0,0" AutoGeneratingColumn="DataGrid_AutoGeneratingColumn"/></Grid></TabItem>
         <TabItem x:Name="MastersTab" Header="Мастера"><Grid Margin="6"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><WrapPanel><Button Content="Добавить мастера" Width="130" Click="AddMasterButton_Click"/><Button Content="Изменить" Margin="8,0,0,0" Click="EditMasterButton_Click"/><Button Content="Удалить" Margin="8,0,0,0" Click="DeleteMasterButton_Click"/></WrapPanel><DataGrid x:Name="MastersGrid" Grid.Row="1" AutoGenerateColumns="True" IsReadOnly="True" Margin="0,8,0,0" AutoGeneratingColumn="DataGrid_AutoGeneratingColumn"/></Grid></TabItem>
         <TabItem x:Name="PartsTab" Header="Запчасти"><Grid Margin="6"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><WrapPanel><Button Content="Добавить запчасть" Width="140" Click="AddPartButton_Click"/><Button Content="Изменить" Margin="8,0,0,0" Click="EditPartButton_Click"/><Button Content="Удалить" Margin="8,0,0,0" Click="DeletePartButton_Click"/></WrapPanel><DataGrid x:Name="PartsCatalogGrid" Grid.Row="1" AutoGenerateColumns="True" IsReadOnly="True" Margin="0,8,0,0" AutoGeneratingColumn="DataGrid_AutoGeneratingColumn"/></Grid></TabItem>
        <TabItem x:Name="ReportsTab" Header="Отчёты"><StackPanel Margin="12"><TextBlock Text="Отчёты сервисного центра" FontSize="18" FontWeight="Bold"/><TextBlock Text="Период отчёта (необязательно):" Margin="0,8,0,4"/><WrapPanel><DatePicker x:Name="ReportFromDatePicker" Width="130"/><DatePicker x:Name="ReportToDatePicker" Width="130" Margin="8,0,0,0"/></WrapPanel><WrapPanel Margin="0,12,0,0"><Button Content="Отчёт по выручке" Width="150" Click="RevenueReportButton_Click"/><Button Content="Загрузка мастеров" Width="150" Margin="8,0,0,0" Click="WorkloadReportButton_Click"/></WrapPanel><TextBlock x:Name="ReportText" TextWrapping="Wrap" Margin="0,14,0,0"/></StackPanel></TabItem>
      </TabControl>
    </DockPanel>
    <TextBlock x:Name="FooterStatusText" VerticalAlignment="Bottom" Foreground="Gray" />
  </Grid>
</Window>
